# 版权材料：已下载的论文 PDF 与抽取的全文文本，不随仓库分发
docs/papers/*.pdf
docs/papers/_extracted/

# 运行时缓存
__pycache__/
*.pyc
*.npz
*.pkl
.pytest_cache/

# 外部仓库的 clone（代码层面审计用，不随本仓库分发）
external/repos/

# ARIS 运行期
.aris/tools/*.pyc

# regenerable descriptor caches
*.npy
# downloaded article PDF (CC BY 4.0); extracted text kept in-repo
.research/peng2026/*.pdf

# downloaded journal PDFs (text extracts retained)
.research/citations/*.pdf
